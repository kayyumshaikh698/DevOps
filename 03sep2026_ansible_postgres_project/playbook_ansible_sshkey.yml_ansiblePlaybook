---
- name: ansible playbook
  hosts: ansible
  gather_facts: yes
  become: true
  become_method: sudo
  tasks:
    - name: Ensure .ssh directory exists
      ansible.builtin.file:
        path: /home/kayyum/.ssh
        state: directory
        owner: kayyum
        group: kayyum
        mode: '0700'

    - name: Generate SSH keypair on target machine
      community.crypto.openssh_keypair:
        path: /home/kayyum/.ssh/id_ed25519
        type: ed25519
        size: 4096
        owner: kayyum
        group: kayyum
        mode: '0600'
