---
- name: ansible playbook
  hosts: jenkins
  gather_facts: yes
  become: true
  become_method: sudo
  tasks:
    - name: Ensure .ssh directory exists
      ansible.builtin.file:
        path: /var/jenkins_home
        state: directory
        owner: jenkins
        group: jenkins
        mode: '0700'

    - name: Generate SSH keypair on target machine
      community.crypto.openssh_keypair:
        path: /var/jenkins_home/.ssh/id_ed25519
        type: ed25519
        size: 4096
        owner: jenkins
        group: jenkins
        mode: '0600'
